    "ANTHROPIC_AUTH_TOKEN": "team-a6923179a034de8e0b7cfc33eddda86fb507fd12f7d91828",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
